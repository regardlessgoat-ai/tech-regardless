# Tech.Regardless — environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.

# Public site URL — used by sitemap, robots, and OG metadata.
NEXT_PUBLIC_SITE_URL=https://techregardless.com

# Resend — for the contact form. Sign up at https://resend.com and create an API key.
RESEND_API_KEY=

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=tech.regardless@gmail.com

# The "from" address Resend sends as. Must be on a domain you've verified in
# Resend — Gmail/free providers won't work here. Keep this on techregardless.com
# (or whatever sending domain you verify); the reply-to is the lead's address.
CONTACT_FROM_EMAIL=Tech.Regardless <hello@techregardless.com>

# Optional. The "from" address on the automatic confirmation sent back to the
# person who submitted the form. Must also be on a domain verified in Resend.
# Falls back to CONTACT_FROM_EMAIL when left blank.
CONTACT_AUTOREPLY_FROM_EMAIL=

# Calendly link surfaced in the hero and CTAs.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle

# Telegram bot — pings you whenever someone submits the contact form.
# Setup:
#   1. Open Telegram, message @BotFather, run /newbot, follow prompts, copy the token.
#   2. Message your new bot anything (just to open the chat).
#   3. Message @userinfobot to get your numeric chat ID.
# Both vars must be set or notifications are silently skipped.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
