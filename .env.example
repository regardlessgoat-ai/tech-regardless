# Tech.Regardless — environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# Everything below degrades safely when blank EXCEPT the three Resend vars:
# without those the production form refuses submissions on purpose.

# Public site URL — used by sitemap, robots, and OG metadata.
NEXT_PUBLIC_SITE_URL=https://techregardless.com

# ── Email (Resend) — load-bearing ────────────────────────────────────────────
# https://resend.com → API Keys. The sending domain must be verified in Resend.
RESEND_API_KEY=
# Where lead notifications land (your inbox).
CONTACT_TO_EMAIL=ali@techregardless.com
# The address Resend sends as. Must be on a verified domain.
CONTACT_FROM_EMAIL=Tech.Regardless <hello@techregardless.com>
# Optional. The "from" on messages the front desk sends to leads. Falls back to
# CONTACT_FROM_EMAIL.
CONTACT_AUTOREPLY_FROM_EMAIL=Ali at Tech.Regardless <ali@techregardless.com>

# ── Operator notifications (Twilio SMS) ──────────────────────────────────────
# Trial accounts can only text numbers verified in the Twilio console — verify
# OPERATOR_PHONE there. All four must be set or texts are skipped (logged).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1
OPERATOR_PHONE=+1

# ── Front desk brain (Anthropic) ─────────────────────────────────────────────
# https://console.anthropic.com → API keys. Blank = the plain confirmation
# email sends instead of the AI message.
ANTHROPIC_API_KEY=

# ── Front desk replies (Resend receiving + thread store) ─────────────────────
# 1. In Resend add a RECEIVING domain on a subdomain, e.g. reply.techregardless.com,
#    and publish its MX record. Never the root domain — Google Workspace owns it.
# 2. Add a webhook for event "email.received" → https://techregardless.com/api/inbound/email
#    and copy its signing secret.
# 3. Install "Upstash for Redis" from the Vercel marketplace on this project;
#    it sets the two UPSTASH_* vars (or KV_REST_API_*) automatically.
FRONTDESK_REPLY_ADDRESS=frontdesk@reply.techregardless.com
RESEND_WEBHOOK_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
